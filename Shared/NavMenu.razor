@inject NavigationManager Navigation
@implements IDisposable

@* Wider screens: every page as a link in the header *@
<nav class="top-nav d-none d-md-flex" aria-label="Main">
    @NavLinkItem("", "Recipes", "bi-book", current == NavSection.Recipes)
    @NavLinkItem("search-by-ingredients", "Find by ingredient", "bi-search", current == NavSection.Find)
    @NavLinkItem("grocery-list", "Grocery list", "bi-cart", current == NavSection.Grocery)
    @NavLinkItem("ingredients", "Ingredients", "bi-list-check", current == NavSection.Ingredients)
    @NavLinkItem("import-export", "Import/Export", "bi-arrow-left-right", current == NavSection.ImportExport)
</nav>

@* Phones: four items in a bar along the bottom, within thumb reach *@
<nav class="bottom-nav d-md-none" aria-label="Main">
    @NavLinkItem("", "Recipes", "bi-book", current == NavSection.Recipes)
    @NavLinkItem("search-by-ingredients", "Find", "bi-search", current == NavSection.Find)
    @NavLinkItem("grocery-list", "Grocery", "bi-cart", current == NavSection.Grocery)
    @NavLinkItem("more", "More", "bi-three-dots", AppNav.IsUnderMore(current))
</nav>

@code {
    private NavSection current;

    protected override void OnInitialized()
    {
        current = AppNav.SectionFor(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        current = AppNav.SectionFor(Navigation.ToBaseRelativePath(e.Location));
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    // Real links (not buttons) so they can be long-pressed or opened in a new tab, and
    // aria-current tells screen readers which page this is
    private RenderFragment NavLinkItem(string href, string label, string icon, bool active) =>
        @<a href="@href" class="nav-link-item @(active ? "active" : "")" aria-current="@(active ? "page" : null)">
            <span class="bi @icon" aria-hidden="true"></span>
            <span class="nav-label">@label</span>
        </a>;
}
