<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Test code lives under tests/ in its own project; keep it out of the app build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <!--
      Since .NET 10 the Blazor script (blazor.server.js) comes from a NuGet package that the SDK
      only adds when the project contains .razor files. The Dockerfile restores before copying the
      source, so restore can't see them; without this the image ships without the script and the
      UI is dead. Documented in Microsoft Learn: "ASP.NET Core Blazor project structure".
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>

