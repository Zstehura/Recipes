@page "/grocery-list"
@using RecipesApp.Models
@using RecipesApp.Services
@inject RecipeService RecipeService
@inject GroceryListService GroceryListService
@inject IJSRuntime JSRuntime
@inject ILogger<GroceryList> Logger
@inject DraftService Drafts

<PageTitle>@AppInfo.Title("Grocery list")</PageTitle>

<h1 class="h3 mb-3">Grocery list</h1>

@if (showingList && groceryList != null)
{
    @* The list itself: what you look at in the shop *@
    <section class="grocery-result" aria-labelledby="list-heading">
        <div class="d-flex align-items-baseline justify-content-between gap-2">
            <h2 id="list-heading" class="h5" tabindex="-1" @ref="listHeading">Your list</h2>
            @if (gotItems.Count > 0)
            {
                <button type="button" class="btn btn-link p-0" @onclick="() => gotItems.Clear()">Uncheck all</button>
            }
        </div>
        <p class="text-muted small">From @SelectionSummary</p>

        @* Above the list, so a long list doesn't push them off screen *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-primary" @onclick="CopyToClipboardAsync">
                <span class="bi bi-clipboard" aria-hidden="true"></span> Copy
            </button>
            @if (canShare)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="ShareAsync">
                    <span class="bi bi-share" aria-hidden="true"></span> Share
                </button>
            }
            <span class="small" role="status">@copyMessage</span>
        </div>

        @if (groceryList.Items.Count == 0)
        {
            <div class="empty-state">
                <p class="mb-0">There's nothing to buy: these recipes have no ingredients, or they've been deleted.</p>
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">Tap an item once it's in your basket.</p>
            @* Same checklist as the cooking view *@
            <ul class="ingredient-checklist grocery-items">
                @foreach (var item in groceryList.Items)
                {
                    var got = gotItems.Contains(item.Key);
                    <li @key="item.Key">
                        <label class="ingredient-check @(got ? "done" : "")">
                            <input type="checkbox" class="form-check-input" checked="@got" @onchange="() => ToggleGot(item.Key)" />
                            <span>
                                @if (item.Quantity is null)
                                {
                                    @item.Name
                                }
                                else if (item.Quantity < 0.01m)
                                {
                                    @item.Name <span class="text-muted">(@item.Amount)</span>
                                }
                                else
                                {
                                    <strong>@item.Amount</strong>
                                    @(" ")
                                    @item.Name
                                }
                            </span>
                        </label>
                    </li>
                }
            </ul>
        }

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => showingList = false">
                <span class="bi bi-pencil" aria-hidden="true"></span> Change recipes
            </button>
            <button type="button" class="btn btn-link text-danger" @onclick="RequestStartOver">Start over</button>
        </div>
    </section>
}
else
{
    <p class="text-muted">Pick the recipes you're making, then make one combined list.</p>

    <div class="d-flex gap-2 mb-3">
        <div class="flex-grow-1">
            <label for="grocery-search" class="visually-hidden">Search recipes</label>
            <input id="grocery-search" type="search" class="form-control" placeholder="Search recipes"
                   @bind="searchTerm" @bind:event="oninput" @bind:after="LoadRecipes" />
        </div>
        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleFilters"
                aria-expanded="@(showFilters ? "true" : "false")" aria-controls="grocery-filters">
            <span class="bi bi-funnel" aria-hidden="true"></span> Filters
            @if (!filters.IsEmpty)
            {
                <span class="badge rounded-pill text-bg-primary ms-1">@filters.ActiveCount<span class="visually-hidden"> on</span></span>
            }
        </button>
    </div>

    @if (showFilters)
    {
        <RecipeFilterPanel Id="grocery-filters" State="filters" AvailableTags="availableTags"
                           OnChanged="LoadRecipes" OnClear="ClearFilters" CanClear="HasFilters" />
    }

    @if (recipes == null)
    {
        <p><em>Loading recipes...</em></p>
    }
    else if (!recipes.Any() && !HasFilters)
    {
        <div class="empty-state">
            <p class="mb-3">No recipes yet.</p>
            <a href="recipe/new" class="btn btn-primary">Add your first recipe</a>
        </div>
    }
    else if (!recipes.Any())
    {
        <div class="empty-state" role="status">
            <p class="mb-3">No recipes match your search.</p>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear search and filters</button>
        </div>
    }
    else
    {
        <ul class="pick-list">
            @foreach (var recipe in recipes)
            {
                var isSelected = selectedRecipeMultipliers.ContainsKey(recipe.Id);
                var ingredientCount = recipe.RecipeIngredients?.Count ?? 0;
                <li @key="recipe.Id" class="pick-row @(isSelected ? "selected" : "")">
                    <label class="pick-row-main" for="recipe-@recipe.Id">
                        <input class="form-check-input" type="checkbox" id="recipe-@recipe.Id" checked="@isSelected"
                               @onchange="@((e) => ToggleRecipeSelection(recipe.Id, e.Value))" />
                        <span>
                            <span class="pick-row-name">@recipe.Name</span>
                            <span class="pick-row-meta">
                                @recipe.CookingTime min · @ingredientCount @(ingredientCount == 1 ? "ingredient" : "ingredients")
                            </span>
                        </span>
                    </label>
                    @if (isSelected)
                    {
                        <QuantityStepper Label="@($"Batches of {recipe.Name}")" Min="1" Max="10"
                                         Value="selectedRecipeMultipliers[recipe.Id]"
                                         ValueChanged="v => SetMultiplier(recipe.Id, v)" />
                    }
                </li>
            }
        </ul>
    }

    @* Always within thumb reach, above the bottom nav *@
    <div class="action-bar">
        <span class="action-bar-status" role="status">
            @selectedRecipeMultipliers.Count @(selectedRecipeMultipliers.Count == 1 ? "recipe" : "recipes") selected
        </span>
        @if (selectedRecipeMultipliers.Any())
        {
            <button type="button" class="btn btn-link" @onclick="RequestStartOver">Clear</button>
        }
        @if (groceryList != null)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="ShowList">View list</button>
        }
        <button type="button" class="btn btn-primary" @onclick="GenerateGroceryListAsync"
                disabled="@(!selectedRecipeMultipliers.Any() || isGenerating)">
            @if (isGenerating)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            }
            Make list
        </button>
    </div>
}

<ConfirmDialog Open="confirmingStartOver" Title="Start a new list?" ConfirmLabel="Start over"
               OnConfirm="ConfirmStartOverAsync" OnCancel="() => confirmingStartOver = false">
    <p class="mb-0">This clears your list and the recipes you picked.</p>
</ConfirmDialog>

@code {
    private List<Recipe>? recipes;
    private Dictionary<int, int> selectedRecipeMultipliers = new();
    private Dictionary<int, string> selectedRecipeNames = new();
    private CombinedGroceryList? groceryList;
    private HashSet<string> gotItems = new();   // items ticked off in the shop, by GroceryItem.Key
    private bool showingList;
    private bool focusList;
    private bool isGenerating = false;
    private bool confirmingStartOver;
    private bool canShare;
    private string? copyMessage;
    private string searchTerm = string.Empty;
    private bool showFilters = false;
    private RecipeFilterState filters = new();
    private List<string> availableTags = new();
    private DraftAutosave<GroceryListDraft>? autosave;
    private ElementReference listHeading;

    private bool HasFilters => !filters.IsEmpty || !string.IsNullOrWhiteSpace(searchTerm);

    // e.g. "2 × Pancakes, 1 × Curry"
    private string SelectionSummary => string.Join(", ", selectedRecipeMultipliers.Select(item =>
        $"{item.Value} × {selectedRecipeNames.GetValueOrDefault(item.Key, "Unknown")}"));

    protected override async Task OnInitializedAsync()
    {
        await LoadRecipes();
        availableTags = await RecipeService.GetAllTagsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Browser storage and browser features are only reachable once the page is interactive
            canShare = await JSRuntime.InvokeAsync<bool>("appShare.canShare");
            await RestoreDraftAsync();
            return;
        }

        if (focusList)
        {
            // Move to the list, for screen readers and so it's in view after a long scroll
            focusList = false;
            await listHeading.FocusAsync();
        }

        if (autosave != null)
        {
            await autosave.SaveIfChangedAsync(CaptureDraft());
        }
    }

    private GroceryListDraft CaptureDraft() => new(
        new SortedDictionary<int, int>(selectedRecipeMultipliers),
        new SortedDictionary<int, string>(selectedRecipeNames),
        groceryList,
        searchTerm,
        showFilters,
        filters.MinCookTime,
        filters.MaxCookTime,
        filters.MinServings,
        filters.MaxServings,
        filters.Tags.Order().ToList(),
        gotItems.Order().ToList());

    private async Task RestoreDraftAsync()
    {
        autosave = new DraftAutosave<GroceryListDraft>(Drafts, GroceryListDraft.Key, DraftLifetime.Device);
        var baseline = CaptureDraft();

        var draft = await Drafts.RestoreAsync<GroceryListDraft>(GroceryListDraft.Key, DraftLifetime.Device);
        if (draft != null)
        {
            var saved = draft.Value;
            selectedRecipeMultipliers = new Dictionary<int, int>(saved.Multipliers);
            selectedRecipeNames = new Dictionary<int, string>(saved.RecipeNames);
            groceryList = saved.GeneratedList;
            gotItems = (saved.GotItems ?? new()).ToHashSet();
            showingList = saved.GeneratedList != null;   // back in the shop: the list comes first
            searchTerm = saved.SearchTerm;
            showFilters = saved.ShowFilters;
            filters = new RecipeFilterState
            {
                MinCookTime = saved.MinCookTime,
                MaxCookTime = saved.MaxCookTime,
                MinServings = saved.MinServings,
                MaxServings = saved.MaxServings,
                Tags = saved.Tags.ToHashSet(),
            };
            await LoadRecipes();   // re-run the search with the restored filters
        }

        autosave.Start(baseline);
        StateHasChanged();
    }

    private async Task LoadRecipes()
    {
        if (!HasFilters)
        {
            recipes = await RecipeService.GetAllRecipesAsync();
        }
        else
        {
            recipes = await RecipeService.FilterRecipesAsync(
                searchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                minCookTime: filters.MinCookTime,
                maxCookTime: filters.MaxCookTime,
                tags: filters.Tags.Count > 0 ? filters.Tags.ToList() : null,
                minServings: filters.MinServings,
                maxServings: filters.MaxServings
            );
        }
        StateHasChanged();
    }

    private void ToggleRecipeSelection(int recipeId, object? isChecked)
    {
        if (isChecked is bool checkedValue)
        {
            if (checkedValue)
            {
                selectedRecipeMultipliers[recipeId] = 1;
                var recipe = recipes?.FirstOrDefault(r => r.Id == recipeId);
                if (recipe != null) selectedRecipeNames[recipeId] = recipe.Name;
            }
            else
            {
                selectedRecipeMultipliers.Remove(recipeId);
                selectedRecipeNames.Remove(recipeId);
            }
        }
    }

    private void SetMultiplier(int recipeId, int multiplier)
    {
        if (selectedRecipeMultipliers.ContainsKey(recipeId) && multiplier >= 1 && multiplier <= 10)
        {
            selectedRecipeMultipliers[recipeId] = multiplier;
        }
    }

    private async Task GenerateGroceryListAsync()
    {
        isGenerating = true;
        copyMessage = null;
        StateHasChanged();

        try
        {
            groceryList = await GroceryListService.GenerateGroceryListAsync(selectedRecipeMultipliers);
            gotItems.Clear();   // a new list starts with nothing ticked
            showingList = true;
            focusList = true;
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private void ToggleGot(string key)
    {
        if (!gotItems.Remove(key))
        {
            gotItems.Add(key);
        }
    }

    private void ShowList()
    {
        showingList = true;
        focusList = true;
    }

    // Losing a made list is annoying in the shop, so that asks first; a bare selection just clears
    private async Task RequestStartOver()
    {
        if (groceryList == null)
        {
            await ClearSelection();
        }
        else
        {
            confirmingStartOver = true;
        }
    }

    private async Task ConfirmStartOverAsync()
    {
        confirmingStartOver = false;
        await ClearSelection();
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filters.Clear();
        await LoadRecipes();
    }

    private async Task ClearSelection()
    {
        selectedRecipeMultipliers.Clear();
        selectedRecipeNames.Clear();
        groceryList = null;
        gotItems.Clear();
        showingList = false;
        copyMessage = null;
        await ClearFilters();
    }

    private async Task CopyToClipboardAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("appShare.copy", groceryList?.ToText());
            copyMessage = "Copied.";
            StateHasChanged();

            // Clear message after 3 seconds
            await Task.Delay(3000);
            copyMessage = null;
            StateHasChanged();
        }
        catch (JSException ex)
        {
            // The browser refused (no clipboard permission, or no copy support at all)
            Logger.LogInformation(ex, "Clipboard copy failed");
            copyMessage = "Couldn't copy. Press and hold the list to select it instead.";
            StateHasChanged();
        }
    }

    private async Task ShareAsync()
    {
        try
        {
            await JSRuntime.InvokeAsync<bool>("appShare.share", "Grocery list", groceryList?.ToText());
        }
        catch (JSException ex)
        {
            Logger.LogInformation(ex, "Sharing failed");
            copyMessage = "Couldn't share. Try Copy instead.";
        }
    }
}
