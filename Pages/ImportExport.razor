@page "/import-export"
@using RecipesApp.Models
@using RecipesApp.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject RecipeService RecipeService
@inject RecipeImportExportService ImportExportService
@inject IJSRuntime JSRuntime
@inject ILogger<ImportExport> Logger

<PageTitle>@AppInfo.Title("Import and export")</PageTitle>

<h1 class="h3 mb-3">Import and export</h1>

<section class="mb-4" aria-labelledby="export-heading">
    <h2 id="export-heading" class="h5">Export</h2>
    <p>Save all your recipes to a text file you can edit and import again later.</p>
    <button type="button" class="btn btn-primary" @onclick="ExportRecipes" disabled="@isExporting">
        <span class="bi bi-download" aria-hidden="true"></span> @(isExporting ? "Exporting..." : "Export all recipes")
    </button>
    <div aria-live="polite">
        @if (!string.IsNullOrEmpty(exportMessage))
        {
            <div class="alert alert-info mt-3 mb-0">@exportMessage</div>
        }
    </div>
</section>

<section class="mb-4" aria-labelledby="import-heading">
    <h2 id="import-heading" class="h5">Import</h2>
    <p>Paste recipe text or choose a text file. The format guide below shows how to write it.</p>

    <label for="import-text" class="form-label">Recipe text</label>
    <textarea id="import-text" class="form-control font-monospace mb-2" rows="8" @bind="pastedText"
              placeholder="===== RECIPE =====" spellcheck="false"></textarea>
    <button type="button" class="btn btn-outline-primary mb-3" @onclick="ParsePastedText"
            disabled="@(isProcessing || string.IsNullOrWhiteSpace(pastedText))">
        Read text
    </button>

    <label for="import-file" class="form-label d-block">Or choose a text file</label>
    <InputFile id="import-file" OnChange="HandleFileSelected" class="form-control mb-3" accept=".txt" />

    @* Results of reading the text appear here; screen readers announce them *@
    <div aria-live="polite">
        @if (isProcessing)
        {
            <div class="alert alert-info">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                Reading recipes...
            </div>
        }

        @if (importErrors.Any())
        {
            <div class="alert alert-warning">
                <h3 class="h6 alert-heading"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Import warnings</h3>
                <ul class="mb-0">
                    @foreach (var error in importErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrEmpty(importSuccessMessage))
        {
            <div class="alert alert-success">
                <span class="bi bi-check-circle" aria-hidden="true"></span> @importSuccessMessage
            </div>
        }

        @if (parsedRecipes.Any())
        {
            <h3 class="h6">@RecipeCount(parsedRecipes.Count) ready to import</h3>
        }
    </div>

    @if (parsedRecipes.Any())
    {
        <ul class="import-preview">
            @foreach (var recipe in parsedRecipes)
            {
                <li>
                    <span class="import-preview-name">@recipe.Name</span>
                    <span class="import-preview-meta">@PreviewMeta(recipe)</span>
                </li>
            }
        </ul>

        <div class="action-bar">
            <span class="action-bar-status">@RecipeCount(parsedRecipes.Count)</span>
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelImport" disabled="@isImporting">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="ConfirmImport" disabled="@isImporting">
                @(isImporting ? "Importing..." : "Import")
            </button>
        </div>
    }
</section>

<details class="form-extras">
    <summary>Format guide</summary>
    <h3 class="h6">Recipe Format Structure</h3>
    <p>Each recipe must follow this structure with specific delimiters:</p>

    <pre class="bg-light p-3 border rounded"><code>===== RECIPE =====
Name: Chocolate Chip Cookies
Cooking Time: 25 minutes
Servings: 24
Tags: Dessert,Baking,Easy

===== INGREDIENTS =====
250g all-purpose flour
200g butter
150g brown sugar
100g chocolate chips
2pieces eggs
1tsp vanilla extract
1tsp baking soda

===== INSTRUCTIONS =====
1. Preheat oven to 350°F (175°C).
2. Mix butter and sugar until creamy.
3. Add eggs and vanilla, mix well.
4. In a separate bowl, combine flour and baking soda.
5. Gradually add dry ingredients to wet ingredients.
6. Fold in chocolate chips.
7. Drop spoonfuls onto baking sheet.
8. Bake for 10-12 minutes until golden brown.

===== NOTES =====
Best served warm. Store in airtight container for up to 5 days.

===== END RECIPE =====</code></pre>

    <h3 class="h6 mt-4">Required Fields</h3>
    <ul>
        <li><strong>Name:</strong> Recipe name (max 200 characters)</li>
        <li><strong>Cooking Time:</strong> Number of minutes (accepts "30", "30 min", or "30 minutes")</li>
        <li><strong>Servings:</strong> Number of servings (must be at least 1)</li>
        <li><strong>Instructions:</strong> Step-by-step cooking instructions</li>
    </ul>

    <h3 class="h6 mt-4">Optional Fields</h3>
    <ul>
        <li><strong>Tags:</strong> Comma-separated list of tags (e.g., "Italian,Vegetarian,Quick")</li>
        <li><strong>Notes:</strong> Additional notes about the recipe</li>
    </ul>

    <h3 class="h6 mt-4">Ingredient Format</h3>
    <p>Format: <code>quantity unit name</code> or <code>quantity name</code> (unit defaults to pieces)</p>
    <p>Examples:</p>
    <ul>
        <li><code>250g flour</code> - Space between quantity and unit is optional</li>
        <li><code>2 cups milk</code> - Space between quantity and unit</li>
        <li><code>3pieces eggs</code> - No space works too</li>
        <li><code>2 eggs</code> - No unit specified, defaults to pieces</li>
        <li><code>3/4 cup sugar</code> - Fractions are converted to decimals (0.75)</li>
        <li><code>1 1/2 tsp vanilla</code> - Mixed fractions work too (1.5)</li>
        <li><code>salt to taste</code> - If format doesn't match, treats entire line as ingredient name</li>
    </ul>
    <p class="text-muted small"><strong>Note:</strong> Ingredient names are case-insensitive. "Flour", "flour", and "FLOUR" will all match the same ingredient.</p>

    <h3 class="h6 mt-4">Supported Units</h3>
    <div class="row">
        <div class="col-md-4">
            <strong>Weight:</strong>
            <ul class="small">
                <li>g, gram, grams</li>
                <li>kg, kilogram, kilograms</li>
                <li>oz, ounce, ounces</li>
                <li>lb, lbs, pound, pounds</li>
            </ul>
        </div>
        <div class="col-md-4">
            <strong>Volume:</strong>
            <ul class="small">
                <li>ml, milliliter, milliliters</li>
                <li>l, liter, liters</li>
                <li>cup, cups</li>
                <li>tbsp, tablespoon, tablespoons</li>
                <li>tsp, teaspoon, teaspoons</li>
                <li>fl oz, floz, fluidounce</li>
            </ul>
        </div>
        <div class="col-md-4">
            <strong>Count:</strong>
            <ul class="small">
                <li>piece, pieces</li>
                <li>pcs, pc</li>
            </ul>
        </div>
    </div>

    <h3 class="h6 mt-4">Multiple Recipes</h3>
    <p>You can include multiple recipes in a single file. Just repeat the structure above for each recipe, making sure each one ends with <code>===== END RECIPE =====</code></p>

    <h3 class="h6 mt-4">Tips for Writing Recipes</h3>
    <ul>
        <li>The format is flexible - reasonable spacing and formatting variations are handled automatically</li>
        <li>If an ingredient line doesn't match the quantity+unit+name format, it will be imported as just a name</li>
        <li>Missing optional fields (Tags, Notes) are fine - they'll just be left empty</li>
        <li>If you're unsure, export an existing recipe to see the exact format</li>
    </ul>
</details>

@code {
    private bool isExporting = false;
    private bool isProcessing = false;
    private bool isImporting = false;
    private string exportMessage = "";
    private string importSuccessMessage = "";
    private string pastedText = "";

    private List<Recipe> parsedRecipes = new();
    private List<string> importErrors = new();

    private static string RecipeCount(int count) => count == 1 ? "1 recipe" : $"{count} recipes";

    private static string PreviewMeta(Recipe recipe)
    {
        var parts = new List<string>
        {
            $"{recipe.CookingTime} min",
            recipe.Servings == 1 ? "1 serving" : $"{recipe.Servings} servings",
            recipe.RecipeIngredients.Count == 1 ? "1 ingredient" : $"{recipe.RecipeIngredients.Count} ingredients",
        };
        if (!string.IsNullOrWhiteSpace(recipe.Tags))
        {
            parts.Add(string.Join(", ", recipe.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)));
        }
        return string.Join(" · ", parts);
    }

    private void ParsePastedText()
    {
        isProcessing = true;
        parsedRecipes.Clear();
        importErrors.Clear();
        importSuccessMessage = "";
        StateHasChanged();

        try
        {
            var (recipes, errors) = ImportExportService.ParseRecipeText(pastedText);

            parsedRecipes = recipes;
            importErrors = errors;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to parse pasted import text ({Length} characters)", pastedText.Length);
            importErrors.Add("Something went wrong reading the text. Please check the format and try again.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ExportRecipes()
    {
        isExporting = true;
        exportMessage = "";
        StateHasChanged();

        try
        {
            var recipes = await RecipeService.GetAllRecipesAsync();

            if (!recipes.Any())
            {
                exportMessage = "No recipes to export.";
                return;
            }

            var exportText = ImportExportService.ExportRecipesToText(recipes.ToList());
            var filename = $"recipes_export_{DateTime.Now:yyyyMMdd_HHmmss}.txt";

            await JSRuntime.InvokeVoidAsync("downloadFile", filename, exportText);

            exportMessage = $"Exported {RecipeCount(recipes.Count)} to {filename}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export recipes");
            exportMessage = "Export failed. Please try again.";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        parsedRecipes.Clear();
        importErrors.Clear();
        importSuccessMessage = "";
        StateHasChanged();

        try
        {
            var file = e.File;
            if (file.Size > RecipeImportExportService.MaxImportCharacters)
            {
                importErrors.Add($"The file is too large (limit: {RecipeImportExportService.MaxImportCharacters / 1_000_000} MB).");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: RecipeImportExportService.MaxImportCharacters);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();

            var (recipes, errors) = ImportExportService.ParseRecipeText(text);

            parsedRecipes = recipes;
            importErrors = errors;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read import file ({SizeBytes} bytes)", e.File.Size);
            importErrors.Add("The file couldn't be read. Make sure it's a plain text file and try again.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmImport()
    {
        isImporting = true;
        importSuccessMessage = "";
        StateHasChanged();

        int successCount = 0;
        var newErrors = new List<string>();

        try
        {
            foreach (var recipe in parsedRecipes)
            {
                try
                {
                    // Convert the parsed base-unit lines into entries for RecipeService
                    var ingredientEntries = IngredientEntryMapper.FromRecipeIngredients(recipe.RecipeIngredients);

                    // Clear the RecipeIngredients collection to avoid duplicate processing
                    recipe.RecipeIngredients = new List<RecipeIngredient>();

                    await RecipeService.AddRecipeAsync(recipe, ingredientEntries);
                    successCount++;
                }
                catch (ValidationException ex)
                {
                    // Validation messages are written for users, so they're safe to show
                    newErrors.Add($"Failed to import '{recipe.Name}': {ex.Message}");
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to import a recipe");
                    newErrors.Add($"Failed to import '{recipe.Name}'. Please try again.");
                }
            }

            if (successCount > 0)
            {
                importSuccessMessage = $"Successfully imported {RecipeCount(successCount)}.";

                // Clear the parsed recipes after successful import
                parsedRecipes.Clear();
            }

            if (newErrors.Any())
            {
                importErrors.AddRange(newErrors);
            }
            else if (successCount > 0)
            {
                importErrors.Clear();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Import failed after {SuccessCount} recipe(s)", successCount);
            importErrors.Add("The import stopped because of an unexpected error. Please try again.");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    private void CancelImport()
    {
        parsedRecipes.Clear();
        importErrors.Clear();
        importSuccessMessage = "";
    }
}
