@page "/ingredients"
@using RecipesApp.Models
@using RecipesApp.Services
@inject IngredientService IngredientService

<PageTitle>@AppInfo.Title("Ingredients")</PageTitle>

<h1 class="h3 mb-1">Ingredients</h1>
<p class="text-muted">Rename, merge or remove the ingredients your recipes use.</p>

@* Always in the page, so screen readers announce a message when it appears *@
<div class="page-message" aria-live="polite">
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") d-flex align-items-start gap-2 mb-3">
            <span class="flex-grow-1">@message</span>
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="ClearMessage"></button>
        </div>
    }
</div>

@if (ingredients == null)
{
    <p><em>Loading...</em></p>
}
else if (ingredients.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">No ingredients yet. They're added when you add recipes.</p>
        <a href="recipe/new" class="btn btn-primary">Add a recipe</a>
    </div>
}
else
{
    <label for="ingredient-search" class="visually-hidden">Find an ingredient</label>
    <input id="ingredient-search" type="search" class="form-control mb-2" placeholder="Find an ingredient"
           @bind="searchTerm" @bind:event="oninput" />

    <p class="text-muted small mb-2" role="status">
        @if (string.IsNullOrWhiteSpace(searchTerm))
        {
            @($"{ingredients.Count} {(ingredients.Count == 1 ? "ingredient" : "ingredients")}")
        }
        else
        {
            @($"{VisibleIngredients.Count()} of {ingredients.Count}")
        }
    </p>

    @if (!VisibleIngredients.Any())
    {
        <div class="empty-state">
            <p class="mb-0">No ingredient matches "@searchTerm".</p>
        </div>
    }

    <ul class="manage-list">
        @foreach (var ingredient in VisibleIngredients)
        {
            <li class="manage-row" @key="ingredient.Id">
                <div class="manage-row-summary">
                    <div class="manage-row-main">
                        <span class="manage-row-name">@ingredient.Name</span>
                        <span class="manage-row-meta">@MetaText(ingredient)</span>
                    </div>
                    <OverflowMenu Label="@($"Actions for {ingredient.Name}")">
                        <button type="button" class="overflow-menu-item" @onclick="() => StartRename(ingredient)">
                            <span class="bi bi-pencil" aria-hidden="true"></span> Rename
                        </button>
                        <button type="button" class="overflow-menu-item" @onclick="() => StartChangeUnit(ingredient)">
                            <span class="bi bi-rulers" aria-hidden="true"></span> Change default unit
                        </button>
                        @if (ingredients.Count > 1)
                        {
                            <button type="button" class="overflow-menu-item" @onclick="() => StartMerge(ingredient)">
                                <span class="bi bi-arrow-left-right" aria-hidden="true"></span> Merge into another
                            </button>
                        }
                        <button type="button" class="overflow-menu-item text-danger" @onclick="() => StartDeleteAsync(ingredient)">
                            <span class="bi bi-trash" aria-hidden="true"></span> Delete
                        </button>
                    </OverflowMenu>
                </div>

                @if (renamingId == ingredient.Id)
                {
                    <form class="manage-row-edit" @onsubmit="SaveNameAsync" @onkeydown="CancelOnEscape">
                        <label for="rename-@ingredient.Id" class="form-label">New name</label>
                        <input id="rename-@ingredient.Id" type="text" class="form-control" @ref="editor"
                               @bind="editingName" @bind:event="oninput" />
                        <div class="manage-row-edit-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save name</button>
                        </div>
                    </form>
                }
                else if (changingUnitId == ingredient.Id)
                {
                    <form class="manage-row-edit" @onsubmit="SaveUnitAsync" @onkeydown="CancelOnEscape">
                        <label for="unit-@ingredient.Id" class="form-label">Default unit</label>
                        <select id="unit-@ingredient.Id" class="form-select" @ref="editor" @bind="editingUnit">
                            @foreach (var unit in Enum.GetValues<MeasurementUnit>())
                            {
                                <option value="@unit">@UnitConversionService.GetUnitDisplayName(unit)</option>
                            }
                        </select>
                        <div class="manage-row-edit-actions">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save unit</button>
                        </div>
                    </form>
                }
            </li>
        }
    </ul>
}

<ConfirmDialog Open="merging != null" Title="@($"Merge {merging?.Name}?")" ConfirmLabel="Merge"
               CanConfirm="mergeTargetId != 0" OnConfirm="ConfirmMergeAsync" OnCancel="CloseDialogs">
    <label for="merge-target" class="form-label">Merge into</label>
    <select id="merge-target" class="form-select mb-3" @bind="mergeTargetId">
        <option value="0">Choose an ingredient</option>
        @foreach (var ingredient in (ingredients ?? new()).Where(i => i.Id != merging?.Id))
        {
            <option value="@ingredient.Id">@ingredient.Name</option>
        }
    </select>
    <p class="mb-0">Recipes that use <strong>@merging?.Name</strong> will use the one you choose instead, and
        <strong>@merging?.Name</strong> will be removed. This can't be undone.</p>
</ConfirmDialog>

<ConfirmDialog Open="deleting != null" Title="@($"Delete {deleting?.Name}?")" ConfirmLabel="Delete"
               OnConfirm="ConfirmDeleteAsync" OnCancel="CloseDialogs">
    @if (deletingRecipes is { Count: > 0 })
    {
        <p class="mb-1">It will be removed from:</p>
        <ul class="mb-0">
            @foreach (var recipe in deletingRecipes)
            {
                <li>@recipe.Name</li>
            }
        </ul>
    }
    else
    {
        <p class="mb-0">It isn't used in any recipe.</p>
    }
</ConfirmDialog>

@code {
    private List<Ingredient>? ingredients;
    private Dictionary<int, int> ingredientUsageCounts = new();
    private string searchTerm = string.Empty;

    private int? renamingId;
    private int? changingUnitId;
    private string editingName = string.Empty;
    private MeasurementUnit editingUnit = MeasurementUnit.Pieces;
    private ElementReference editor;
    private bool focusEditor;

    private Ingredient? merging;
    private int mergeTargetId;
    private Ingredient? deleting;
    private List<Recipe>? deletingRecipes;

    private string message = string.Empty;
    private bool isError;

    private IEnumerable<Ingredient> VisibleIngredients =>
        (ingredients ?? new()).Where(i => string.IsNullOrWhiteSpace(searchTerm)
            || i.Name.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase));

    private string MetaText(Ingredient ingredient)
    {
        var count = ingredientUsageCounts.GetValueOrDefault(ingredient.Id, 0);
        var usage = count switch
        {
            0 => "Not used",
            1 => "Used in 1 recipe",
            _ => $"Used in {count} recipes",
        };
        return $"Default unit: {UnitConversionService.GetUnitDisplayName(ingredient.DefaultUnit)} · {usage}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadIngredientsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEditor)
        {
            // Put the cursor in the field that just opened
            focusEditor = false;
            await editor.FocusAsync();
        }
    }

    private async Task LoadIngredientsAsync()
    {
        ingredients = await IngredientService.GetAllIngredientsAsync();
        ingredientUsageCounts.Clear();

        foreach (var ingredient in ingredients)
        {
            var count = await IngredientService.GetIngredientUsageCountAsync(ingredient.Id);
            ingredientUsageCounts[ingredient.Id] = count;
        }
    }

    private void StartRename(Ingredient ingredient)
    {
        CancelEdit();
        renamingId = ingredient.Id;
        editingName = ingredient.Name;
        focusEditor = true;
    }

    private void StartChangeUnit(Ingredient ingredient)
    {
        CancelEdit();
        changingUnitId = ingredient.Id;
        editingUnit = ingredient.DefaultUnit;
        focusEditor = true;
    }

    private void CancelEdit()
    {
        renamingId = null;
        changingUnitId = null;
        editingName = string.Empty;
    }

    private void CancelOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task SaveNameAsync()
    {
        if (renamingId is not int id)
            return;

        if (string.IsNullOrWhiteSpace(editingName))
        {
            ShowMessage("Ingredient name cannot be empty.", true);
            return;
        }

        var success = await IngredientService.RenameIngredientAsync(id, editingName.Trim());
        if (success)
        {
            ShowMessage("Ingredient renamed. All recipes using it have been updated.");
            CancelEdit();
            await LoadIngredientsAsync();
        }
        else
        {
            ShowMessage("Couldn't rename the ingredient. Another ingredient with this name may already exist.", true);
        }
    }

    private async Task SaveUnitAsync()
    {
        if (changingUnitId is not int id)
            return;

        var success = await IngredientService.ChangeDefaultUnitAsync(id, editingUnit);
        if (success)
        {
            ShowMessage("Default unit updated.");
            CancelEdit();
            await LoadIngredientsAsync();
        }
        else
        {
            ShowMessage("Couldn't update the default unit.", true);
        }
    }

    private void StartMerge(Ingredient ingredient)
    {
        CancelEdit();
        merging = ingredient;
        mergeTargetId = 0;
    }

    private async Task StartDeleteAsync(Ingredient ingredient)
    {
        CancelEdit();
        deletingRecipes = await IngredientService.GetRecipesUsingIngredientAsync(ingredient.Id);
        deleting = ingredient;
    }

    private void CloseDialogs()
    {
        merging = null;
        mergeTargetId = 0;
        deleting = null;
        deletingRecipes = null;
    }

    private async Task ConfirmMergeAsync()
    {
        if (merging == null || mergeTargetId == 0)
            return;

        var source = merging.Name;
        var target = ingredients?.FirstOrDefault(i => i.Id == mergeTargetId)?.Name;
        var success = await IngredientService.MergeIngredientsAsync(mergeTargetId, merging.Id);
        CloseDialogs();
        if (success)
        {
            ShowMessage($"Merged '{source}' into '{target}'. All recipes have been updated.");
            await LoadIngredientsAsync();
        }
        else
        {
            ShowMessage("Couldn't merge the ingredients.", true);
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleting == null)
            return;

        var name = deleting.Name;
        var success = await IngredientService.DeleteIngredientAsync(deleting.Id);
        CloseDialogs();
        if (success)
        {
            ShowMessage($"'{name}' deleted. It has been removed from all recipes.");
            await LoadIngredientsAsync();
        }
        else
        {
            ShowMessage("Couldn't delete the ingredient.", true);
        }
    }

    // Messages stay until dismissed or replaced, so there's time to read them
    private void ShowMessage(string text, bool error = false)
    {
        message = text;
        isError = error;
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }
}
