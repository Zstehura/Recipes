@page "/search-by-ingredients"
@using RecipesApp.Models
@using RecipesApp.Services
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject DraftService Drafts

<PageTitle>@AppInfo.Title("Find by ingredient")</PageTitle>

<h1 class="h3 mb-2">Find by ingredient</h1>
<p class="text-muted">Pick ingredients to see the recipes that use all of them.</p>

@if (ingredients == null)
{
    <p><em>Loading ingredients...</em></p>
}
else if (!ingredients.Any())
{
    <div class="empty-state">
        <p class="mb-3">No ingredients yet. They're added when you add recipes.</p>
        <a href="recipe/new" class="btn btn-primary">Add a recipe</a>
    </div>
}
else
{
    <section class="mb-4" aria-labelledby="picker-heading">
        <h2 id="picker-heading" class="visually-hidden">Ingredients</h2>

        @if (selectedIngredientIds.Any())
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @foreach (var ingredient in SelectedIngredients)
                {
                    var name = IngredientService.NormalizeName(ingredient.Name);
                    <button type="button" class="tag-chip is-selected" aria-label="@($"Remove {name}")"
                            @onclick="() => SetIngredientAsync(ingredient.Id, false)">
                        @name <span class="bi bi-x-lg" aria-hidden="true"></span>
                    </button>
                }
                <button type="button" class="btn btn-link" @onclick="ClearIngredientsAsync">Clear</button>
            </div>
        }

        <label for="ingredient-filter" class="visually-hidden">Find an ingredient</label>
        <input id="ingredient-filter" type="search" class="form-control mb-2" placeholder="Find an ingredient"
               @bind="ingredientFilter" @bind:event="oninput" />

        <ul class="ingredient-picker">
            @foreach (var ingredient in VisibleIngredients)
            {
                <li @key="ingredient.Id">
                    <label class="ingredient-check" for="ingredient-@ingredient.Id">
                        <input class="form-check-input" type="checkbox" id="ingredient-@ingredient.Id"
                               checked="@selectedIngredientIds.Contains(ingredient.Id)"
                               @onchange="@((e) => SetIngredientAsync(ingredient.Id, e.Value is true))" />
                        <span>@IngredientService.NormalizeName(ingredient.Name)</span>
                    </label>
                </li>
            }
        </ul>
        @if (!VisibleIngredients.Any())
        {
            <p class="text-muted small">No ingredient matches "@ingredientFilter".</p>
        }
    </section>

    <section aria-labelledby="results-heading">
        <h2 id="results-heading" class="h5" tabindex="-1" @ref="resultsHeading">Recipes</h2>

        @if (!selectedIngredientIds.Any())
        {
            <p class="text-muted" role="status">Pick at least one ingredient to see recipes.</p>
        }
        else
        {
            <div class="d-flex gap-2 mb-3">
                <div class="flex-grow-1">
                    <label for="ingredient-recipe-search" class="visually-hidden">Search these recipes</label>
                    <input id="ingredient-recipe-search" type="search" class="form-control" placeholder="Search these recipes"
                           @bind="searchTerm" @bind:event="oninput" @bind:after="SearchRecipes" />
                </div>
                <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleFilters"
                        aria-expanded="@(showFilters ? "true" : "false")" aria-controls="ingredient-filters">
                    <span class="bi bi-funnel" aria-hidden="true"></span> Filters
                    @if (!filters.IsEmpty)
                    {
                        <span class="badge rounded-pill text-bg-primary ms-1">@filters.ActiveCount<span class="visually-hidden"> on</span></span>
                    }
                </button>
            </div>

            @if (showFilters)
            {
                <RecipeFilterPanel Id="ingredient-filters" State="filters" AvailableTags="availableTags"
                                   OnChanged="SearchRecipes" OnClear="ClearFilters" CanClear="HasFilters" />
            }

            @if (recipes == null)
            {
                <p><em>Searching...</em></p>
            }
            else if (!recipes.Any())
            {
                <div class="empty-state">
                    <p class="mb-0">No recipe uses all of these. Try removing an ingredient@(HasFilters ? " or clearing the filters" : "").</p>
                </div>
            }
            else
            {
                <ul class="recipe-grid">
                    @foreach (var recipe in recipes)
                    {
                        <li @key="recipe.Id"><RecipeCard Recipe="recipe" /></li>
                    }
                </ul>
            }
        }
    </section>

    @if (selectedIngredientIds.Any() && recipes != null)
    {
        @* The results are below a long ingredient list on a phone; this says how many and jumps there *@
        <div class="action-bar">
            <span class="action-bar-status" role="status">
                @recipes.Count @(recipes.Count == 1 ? "recipe matches" : "recipes match")
            </span>
            <button type="button" class="btn btn-primary" disabled="@(!recipes.Any())" @onclick="() => focusResults = true">
                Show recipes
            </button>
        </div>
    }
}

@code {
    private List<Ingredient>? ingredients;
    private List<Recipe>? recipes;
    private HashSet<int> selectedIngredientIds = new();
    private string ingredientFilter = string.Empty;
    private string searchTerm = string.Empty;
    private bool showFilters = false;
    private RecipeFilterState filters = new();
    private List<string> availableTags = new();
    private ElementReference resultsHeading;
    private bool focusResults;

    private DraftAutosave<IngredientSearchDraft>? autosave;

    private bool HasFilters => !filters.IsEmpty || !string.IsNullOrWhiteSpace(searchTerm);

    private IEnumerable<Ingredient> SelectedIngredients =>
        (ingredients ?? new()).Where(i => selectedIngredientIds.Contains(i.Id));

    // The type-to-filter box narrows the list; selected ingredients stay visible as chips above it
    private IEnumerable<Ingredient> VisibleIngredients =>
        (ingredients ?? new()).Where(i => string.IsNullOrWhiteSpace(ingredientFilter)
            || IngredientService.NormalizeName(i.Name).Contains(ingredientFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        ingredients = await IngredientService.GetAllIngredientsAsync();
        availableTags = await RecipeService.GetAllTagsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreSearchAsync();
            return;
        }

        if (focusResults)
        {
            // Bring the results into view and tell screen readers where they are
            focusResults = false;
            await resultsHeading.FocusAsync();
        }

        if (autosave != null)
        {
            await autosave.SaveIfChangedAsync(CaptureSearch());
        }
    }

    private IngredientSearchDraft CaptureSearch() => new(
        selectedIngredientIds.Order().ToList(),
        new RecipeFilters(searchTerm, showFilters, filters.MinCookTime, filters.MaxCookTime,
            filters.MinServings, filters.MaxServings, filters.Tags.Order().ToList()));

    // Kept for this browser tab only (survives a reload, a lost connection, or opening a recipe and coming back)
    private async Task RestoreSearchAsync()
    {
        autosave = new DraftAutosave<IngredientSearchDraft>(Drafts, IngredientSearchDraft.Key, DraftLifetime.Tab);
        var baseline = CaptureSearch();

        var draft = await Drafts.RestoreAsync<IngredientSearchDraft>(IngredientSearchDraft.Key, DraftLifetime.Tab);
        if (draft != null)
        {
            var saved = draft.Value.Filters;
            // Ignore ingredients that no longer exist (deleted or merged since)
            var existingIds = ingredients?.Select(i => i.Id).ToHashSet() ?? new HashSet<int>();
            selectedIngredientIds = draft.Value.SelectedIngredientIds.Where(existingIds.Contains).ToHashSet();
            searchTerm = saved.SearchTerm;
            showFilters = saved.ShowFilters;
            filters = new RecipeFilterState
            {
                MinCookTime = saved.MinCookTime,
                MaxCookTime = saved.MaxCookTime,
                MinServings = saved.MinServings,
                MaxServings = saved.MaxServings,
                Tags = saved.Tags.ToHashSet(),
            };
            await SearchRecipes();
        }

        autosave.Start(baseline);
        StateHasChanged();
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task SetIngredientAsync(int ingredientId, bool selected)
    {
        if (selected)
        {
            selectedIngredientIds.Add(ingredientId);
        }
        else
        {
            selectedIngredientIds.Remove(ingredientId);
        }
        await SearchRecipes();
    }

    private async Task ClearIngredientsAsync()
    {
        selectedIngredientIds.Clear();
        await SearchRecipes();
    }

    private async Task SearchRecipes()
    {
        // Only search if ingredients are selected
        if (selectedIngredientIds.Any())
        {
            recipes = await RecipeService.FilterRecipesByIngredientsWithFiltersAsync(
                ingredientIds: selectedIngredientIds.ToList(),
                searchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                minCookTime: filters.MinCookTime,
                maxCookTime: filters.MaxCookTime,
                tags: filters.Tags.Count > 0 ? filters.Tags.ToList() : null,
                minServings: filters.MinServings,
                maxServings: filters.MaxServings
            );
        }
        else
        {
            recipes = null;
        }
        StateHasChanged();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filters.Clear();
        await SearchRecipes();
    }
}
