@page "/"
@using RecipesApp.Models
@using RecipesApp.Services
@inject RecipeService RecipeService
@inject DraftService Drafts

<PageTitle>@AppInfo.Name</PageTitle>

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Recipes</h1>
    <a href="recipe/new" class="btn btn-primary">
        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add recipe
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <div class="flex-grow-1">
        <label for="recipe-search" class="visually-hidden">Search recipes</label>
        <input id="recipe-search" type="search" class="form-control" placeholder="Search recipes"
               @bind="searchTerm" @bind:event="oninput" @bind:after="LoadRecipes" />
    </div>
    <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleFilters"
            aria-expanded="@(showFilters ? "true" : "false")" aria-controls="recipe-filters">
        <span class="bi bi-funnel" aria-hidden="true"></span> Filters
        @if (!filters.IsEmpty)
        {
            <span class="badge rounded-pill text-bg-primary ms-1">@filters.ActiveCount<span class="visually-hidden"> on</span></span>
        }
    </button>
</div>

@if (showFilters)
{
    <RecipeFilterPanel Id="recipe-filters" State="filters" AvailableTags="availableTags"
                       OnChanged="LoadRecipes" OnClear="ClearFilters" CanClear="HasFilters" />
}

@if (recipes == null)
{
    <p><em>Loading...</em></p>
}
else if (!recipes.Any() && !HasFilters)
{
    <div class="empty-state">
        <p class="mb-3">No recipes yet.</p>
        <a href="recipe/new" class="btn btn-primary">Add your first recipe</a>
    </div>
}
else if (!recipes.Any())
{
    <div class="empty-state" role="status">
        <p class="mb-3">No recipes match your search.</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear search and filters</button>
    </div>
}
else
{
    @if (HasFilters)
    {
        <p class="text-muted small" role="status">@recipes.Count @(recipes.Count == 1 ? "recipe matches" : "recipes match")</p>
    }
    <ul class="recipe-grid">
        @foreach (var recipe in recipes)
        {
            <li @key="recipe.Id"><RecipeCard Recipe="recipe" /></li>
        }
    </ul>
}

@code {
    private List<Recipe>? recipes;
    private string searchTerm = string.Empty;
    private bool showFilters = false;
    private RecipeFilterState filters = new();
    private List<string> availableTags = new();

    private DraftAutosave<RecipeFilters>? autosave;

    private bool HasFilters => !filters.IsEmpty || !string.IsNullOrWhiteSpace(searchTerm);

    protected override async Task OnInitializedAsync()
    {
        await LoadRecipes();
        availableTags = await RecipeService.GetAllTagsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreFiltersAsync();
            return;
        }

        if (autosave != null)
        {
            await autosave.SaveIfChangedAsync(CaptureFilters());
        }
    }

    private RecipeFilters CaptureFilters() => new(
        searchTerm, showFilters, filters.MinCookTime, filters.MaxCookTime, filters.MinServings, filters.MaxServings,
        filters.Tags.Order().ToList());

    // Filters are kept for this browser tab only (they survive a reload or a lost connection,
    // but a new visit starts unfiltered)
    private async Task RestoreFiltersAsync()
    {
        autosave = new DraftAutosave<RecipeFilters>(Drafts, RecipeFilters.RecipeListKey, DraftLifetime.Tab);
        var baseline = CaptureFilters();

        var draft = await Drafts.RestoreAsync<RecipeFilters>(RecipeFilters.RecipeListKey, DraftLifetime.Tab);
        if (draft != null)
        {
            var saved = draft.Value;
            searchTerm = saved.SearchTerm;
            showFilters = saved.ShowFilters;
            filters = new RecipeFilterState
            {
                MinCookTime = saved.MinCookTime,
                MaxCookTime = saved.MaxCookTime,
                MinServings = saved.MinServings,
                MaxServings = saved.MaxServings,
                Tags = saved.Tags.ToHashSet(),
            };
            await LoadRecipes();
        }

        autosave.Start(baseline);
        StateHasChanged();
    }

    private async Task LoadRecipes()
    {
        if (!HasFilters)
        {
            recipes = await RecipeService.GetAllRecipesAsync();
        }
        else
        {
            recipes = await RecipeService.FilterRecipesAsync(
                searchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                minCookTime: filters.MinCookTime,
                maxCookTime: filters.MaxCookTime,
                tags: filters.Tags.Count > 0 ? filters.Tags.ToList() : null,
                minServings: filters.MinServings,
                maxServings: filters.MaxServings
            );
        }
        StateHasChanged();
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filters.Clear();
        await LoadRecipes();
    }
}
