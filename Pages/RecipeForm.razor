@page "/recipe/new"
@page "/recipe/{id:int}/edit"
@using RecipesApp.Models
@using RecipesApp.Services
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject RecipeService RecipeService
@inject NavigationManager Navigation
@inject ILogger<RecipeForm> Logger
@inject DraftService Drafts

<PageTitle>@(recipe.Id > 0 ? "Edit Recipe" : "New Recipe")</PageTitle>

<h1 class="h3 mb-3">@(recipe.Id > 0 ? "Edit recipe" : "New recipe")</h1>

<DraftNotice SavedAt="restoredDraftSavedAt"
             Note="@(Id > 0 ? "Photo changes aren't kept in drafts." : "Photos aren't kept in drafts.")"
             OnDiscard="DiscardDraftAsync" />
@if (staleDraftDiscarded)
{
    <div class="alert alert-warning" role="status">
        Your unsaved changes to this recipe were discarded because it has been changed since.
    </div>
}

<EditForm Model="@recipe" OnValidSubmit="@HandleValidSubmit" class="recipe-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="name">Recipe name</label>
        <InputText id="name" class="form-control" @bind-Value="recipe.Name" />
        <ValidationMessage For="@(() => recipe.Name)" />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label" for="cookingTime">Cooking time (min)</label>
            <InputNumber id="cookingTime" class="form-control" inputmode="numeric" @bind-Value="recipe.CookingTime" />
            <ValidationMessage For="@(() => recipe.CookingTime)" />
        </div>
        <div class="col-6">
            <label class="form-label" for="servings">Servings</label>
            <InputNumber id="servings" class="form-control" inputmode="numeric" @bind-Value="recipe.Servings" />
            <ValidationMessage For="@(() => recipe.Servings)" />
        </div>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label">Ingredients</legend>
        <ul class="ingredient-rows">
            @for (int i = 0; i < ingredientEntries.Count; i++)
            {
                var index = i;
                var entry = ingredientEntries[index];
                var number = index + 1;
                var isLast = index == ingredientEntries.Count - 1;
                <li class="ingredient-row">
                    <div class="ingredient-row-amount">
                        <div>
                            <label class="visually-hidden" for="ing-@index-qty">Ingredient @number amount</label>
                            @if (isLast)
                            {
                                <InputNumber id="@($"ing-{index}-qty")" class="form-control" inputmode="decimal" placeholder="Amount"
                                             @bind-Value="entry.Quantity" @ref="lastQuantityInput" />
                            }
                            else
                            {
                                <InputNumber id="@($"ing-{index}-qty")" class="form-control" inputmode="decimal" placeholder="Amount"
                                             @bind-Value="entry.Quantity" />
                            }
                        </div>
                        <div>
                            <label class="visually-hidden" for="ing-@index-unit">Ingredient @number unit</label>
                            <InputSelect id="@($"ing-{index}-unit")" class="form-select" @bind-Value="entry.Unit">
                                @foreach (var unit in Enum.GetValues<MeasurementUnit>())
                                {
                                    <option value="@unit">@UnitConversionService.GetUnitDisplayName(unit)</option>
                                }
                            </InputSelect>
                        </div>
                        <button type="button" class="btn btn-outline-danger ingredient-remove"
                                aria-label="@($"Remove ingredient {number}{(string.IsNullOrWhiteSpace(entry.Name) ? "" : ": " + entry.Name)}")"
                                @onclick="() => RemoveIngredient(index)">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="ingredient-row-name">
                        <div>
                            <label class="visually-hidden" for="ing-@index-name">Ingredient @number name</label>
                            <InputText id="@($"ing-{index}-name")" class="form-control" placeholder="Ingredient, e.g. flour"
                                       @bind-Value="entry.Name" />
                        </div>
                        <div>
                            <label class="visually-hidden" for="ing-@index-prep">Ingredient @number preparation</label>
                            <InputText id="@($"ing-{index}-prep")" class="form-control" placeholder="Prep, e.g. diced"
                                       @bind-Value="entry.Modifier" />
                        </div>
                    </div>
                </li>
            }
        </ul>
        @if (ingredientEntries.Count == 0)
        {
            <p class="text-danger small mb-2">Add at least one ingredient.</p>
        }
        <button type="button" class="btn btn-outline-primary w-100" @onclick="AddIngredientAndFocus">
            <span class="bi bi-plus-lg" aria-hidden="true"></span> Add ingredient
        </button>
    </fieldset>

    <div class="mb-3">
        <label class="form-label" for="instructions">Instructions</label>
        <InputTextArea id="instructions" class="form-control" rows="8" aria-describedby="instructions-help"
                       @bind-Value="recipe.Instructions" />
        <div id="instructions-help" class="form-text">One step per line.</div>
        <ValidationMessage For="@(() => recipe.Instructions)" />
    </div>

    @* Optional fields: out of the way for a new recipe, open when there's something in them *@
    <details class="form-extras mb-3" open="@HasExtras">
        <summary>More details <span class="text-muted">(tags, notes, photo)</span></summary>

        <div class="mb-3">
            <label class="form-label" for="tags">Tags</label>
            <InputText id="tags" class="form-control" aria-describedby="tags-help" @bind-Value="recipe.Tags" />
            <div id="tags-help" class="form-text">Separate tags with commas, e.g. Italian, Vegetarian, Quick</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="notes">Notes</label>
            <InputTextArea id="notes" class="form-control" rows="4" @bind-Value="recipe.Notes" />
        </div>

        <div class="mb-0">
            <label class="form-label" for="image">Photo</label>
            @if (recipe.ImageContentType != null)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-success small"><span class="bi bi-check-circle" aria-hidden="true"></span> Photo added</span>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveImage">Remove photo</button>
                </div>
            }
            <InputFile id="image" class="form-control" OnChange="HandleImageUpload" accept="image/jpeg,image/png,image/gif,image/webp"
                       aria-describedby="image-help" />
            <div id="image-help" class="form-text">Up to 10MB. @ImageValidator.SupportedFormatsDescription</div>
            @if (!string.IsNullOrEmpty(imageError))
            {
                <div class="text-danger small mt-1" role="alert">@imageError</div>
            }
        </div>
    </details>

    @* Errors sit just above the Save button, where you are when you press it *@
    <div role="alert">
        <ValidationSummary class="text-danger" />
        @if (!string.IsNullOrEmpty(saveError))
        {
            <div class="alert alert-danger">@saveError</div>
        }
    </div>

    <div class="action-bar">
        <span class="action-bar-status"></span>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
        <button type="submit" class="btn btn-primary">Save recipe</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private Recipe recipe = new();
    private List<IngredientEntry> ingredientEntries = new();
    private string imageError = string.Empty;
    private string saveError = string.Empty;

    // Drafts: unsaved changes kept in the browser (see Services/Drafts)
    private DraftAutosave<RecipeDraft>? autosave;
    private DateTime? baseModifiedDate;
    private DateTimeOffset? restoredDraftSavedAt;
    private bool staleDraftDiscarded;
    private bool imageRemoved = false;

    // After "Add ingredient", the new row's first field gets focus
    private InputNumber<decimal?>? lastQuantityInput;
    private bool focusNewIngredient;

    private bool HasExtras => !string.IsNullOrWhiteSpace(recipe.Tags) || !string.IsNullOrWhiteSpace(recipe.Notes)
        || recipe.ImageContentType != null;

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            var existingRecipe = await RecipeService.GetRecipeByIdAsync(Id);
            if (existingRecipe != null)
            {
                recipe = existingRecipe;
                baseModifiedDate = existingRecipe.ModifiedDate;
                imageRemoved = false; // Reset flag when loading existing recipe
                
                // Load image data separately if it exists
                if (existingRecipe.ImageContentType != null)
                {
                    var (imageData, contentType) = await RecipeService.GetRecipeImageAsync(Id);
                    recipe.ImageData = imageData;
                    recipe.ImageContentType = contentType;
                }
                
                // Convert stored base-unit lines into form entries
                ingredientEntries = IngredientEntryMapper.FromRecipeIngredients(existingRecipe.RecipeIngredients);
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        else
        {
            // Add one empty ingredient entry for new recipes
            AddIngredient();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Browser storage needs JavaScript interop, which is only available once the page
            // is interactive, so drafts are restored here rather than in OnInitializedAsync
            await RestoreDraftAsync();
            return;
        }

        if (focusNewIngredient && lastQuantityInput?.Element is ElementReference newRow)
        {
            focusNewIngredient = false;
            await newRow.FocusAsync();
        }

        // After every render, save the form as a draft if anything changed
        if (autosave != null)
        {
            await autosave.SaveIfChangedAsync(CaptureDraft());
        }
    }

    private RecipeDraft CaptureDraft() => RecipeDraft.Capture(recipe, ingredientEntries, baseModifiedDate);

    private async Task RestoreDraftAsync()
    {
        if (Id > 0 && recipe.Id == 0)
        {
            return; // the recipe wasn't found and we're navigating away
        }

        autosave = new DraftAutosave<RecipeDraft>(Drafts, RecipeDraft.KeyFor(Id), DraftLifetime.Device);
        var baseline = CaptureDraft();

        var draft = await Drafts.RestoreAsync<RecipeDraft>(autosave.Key, DraftLifetime.Device);
        if (draft != null && draft.Value.IsStaleFor(recipe))
        {
            await Drafts.DiscardAsync(autosave.Key, DraftLifetime.Device);
            staleDraftDiscarded = true;
        }
        else if (draft != null)
        {
            ingredientEntries = draft.Value.ApplyTo(recipe);
            restoredDraftSavedAt = draft.SavedAt;
        }

        autosave.Start(baseline);
        StateHasChanged();
    }

    private async Task DiscardDraftAsync()
    {
        if (autosave != null)
        {
            await autosave.ClearAsync();
        }

        // Reload the page to show the recipe as it was before the draft
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task CancelAsync()
    {
        // Cancel means "throw away my changes", so the draft goes too
        if (autosave != null)
        {
            await autosave.ClearAsync();
        }

        Navigation.NavigateTo("/");
    }

    private void AddIngredient()
    {
        ingredientEntries.Add(new IngredientEntry 
        { 
            Unit = MeasurementUnit.Pieces 
        });
    }

    private void AddIngredientAndFocus()
    {
        AddIngredient();
        focusNewIngredient = true;
    }

    private void RemoveIngredient(int index)
    {
        if (ingredientEntries.Count > index)
        {
            ingredientEntries.RemoveAt(index);
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        imageError = string.Empty;
        imageRemoved = false; // Reset removal flag when new image is uploaded

        var file = e.File;

        // Reject oversized files before reading them
        if (file.Size > ImageValidator.MaxImageSizeBytes)
        {
            imageError = $"File size exceeds the maximum limit of {ImageValidator.MaxImageSizeBytes / (1024 * 1024)}MB";
            return;
        }

        byte[] imageData;
        try
        {
            // maxAllowedSize is enforced on the server while streaming, whatever the browser claims
            using var stream = file.OpenReadStream(maxAllowedSize: ImageValidator.MaxImageSizeBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            imageData = memoryStream.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read uploaded image ({SizeBytes} bytes)", file.Size);
            imageError = "The image couldn't be uploaded. Please try again.";
            return;
        }

        // Check the actual bytes; the file name and browser-reported type can't be trusted
        var validation = ImageValidator.Validate(imageData);
        if (!validation.IsValid)
        {
            imageError = validation.ErrorMessage!;
            return;
        }

        recipe.ImageData = imageData;
        recipe.ImageContentType = validation.ContentType;
    }

    private void RemoveImage()
    {
        recipe.ImageData = null;
        recipe.ImageContentType = null;
        imageError = string.Empty;
        imageRemoved = true;
    }

    private async Task HandleValidSubmit()
    {
        saveError = string.Empty;

        // Validate that at least one ingredient has a name
        var validIngredients = ingredientEntries
            .Where(e => !string.IsNullOrWhiteSpace(e.Name))
            .ToList();

        if (validIngredients.Count == 0)
        {
            saveError = "Add at least one ingredient.";
            return;
        }

        // If image was explicitly removed, ensure ImageData is null
        if (imageRemoved)
        {
            recipe.ImageData = null;
            recipe.ImageContentType = null;
        }

        try
        {
            if (recipe.Id > 0)
            {
                await RecipeService.UpdateRecipeAsync(recipe, validIngredients, imageRemoved);
            }
            else
            {
                await RecipeService.AddRecipeAsync(recipe, validIngredients);
            }
        }
        catch (ValidationException ex)
        {
            // Validation messages are written for users, so they're safe to show as-is
            saveError = ex.Message;
            return;
        }
        catch (Exception ex)
        {
            // Anything else is unexpected: log the details, show a generic message
            Logger.LogError(ex, "Failed to save recipe {RecipeId}", recipe.Id);
            saveError = "The recipe couldn't be saved. Please try again.";
            return;
        }

        if (autosave != null)
        {
            await autosave.ClearAsync();
        }

        Navigation.NavigateTo("/");
    }
}

